# Copy to `.env` and adjust. Never commit the real .env file.
FLASK_CONFIG=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (SQLite in ./instance by default). Examples:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/plchmi
# DEV_DATABASE_URL=sqlite:///C:/path/dev.sqlite

# 1 = use the built-in PLC simulator instead of real PLCs
PLC_SIMULATION=1
PLC_RECONNECT_DELAY=5
PLC_MAX_READ_SPAN=200
PLC_MAX_READ_GAP=32

# Set to 1 only when serving over HTTPS
SESSION_COOKIE_SECURE=0

# Uploaded images for Image dashboards (default: instance/uploads)
# UPLOAD_FOLDER=D:/plchmi/uploads
# ASSET_MAX_BYTES=5242880

# BACnet/IP local stack (one per HMI server). IP/mask of the network card that
# reaches the BACnet devices, e.g. 192.168.1.20/24 (empty = auto-detect).
# BACNET_LOCAL_IP=192.168.1.20/24
# BACNET_LOCAL_PORT=47808
# BACNET_DEVICE_ID=3056

# Alarms and tag history (historian)
# ALARM_SCANNER=1
# ALARM_SCAN_INTERVAL=2
# HISTORY_LOGGER=1
# HISTORY_RETENTION_DAYS=90
# DISPLAY_TIMEZONE=Europe/Berlin

# Information library (PDF / images attached to PLCs), max file size in bytes
# LIBRARY_MAX_BYTES=26214400

# Browser connection monitor: seconds between heartbeats to /api/health
# SERVER_CHECK_INTERVAL=5

# --- Docker only (docker/entrypoint.sh) -------------------------------------
# For Docker set FLASK_CONFIG=production (docker-compose.yml does it for you).
# First admin user, created on start if missing (remove the password afterwards):
# HMI_ADMIN_USER=admin
# HMI_ADMIN_PASSWORD=change-me-now
# HMI_DEMO=1            # demo PLC + screen (with PLC_SIMULATION=1)
# HMI_THREADS=8         # waitress worker threads
# TZ=Europe/Jerusalem   # server time zone
